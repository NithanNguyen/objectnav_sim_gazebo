<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_robot">

    <!-- Robot mô phỏng = URDF v1 của receptionist_robot (urdf/mobile_robot.urdf.xacro, mesh Model_v1.stl).
         mesh_uri: home_sim.launch.py truyền file://<share>/meshes (Gazebo 11 đọc trực tiếp đường dẫn tuyệt đối,
         không cần GAZEBO_MODEL_PATH); mặc định package:// dùng cho RViz / xacro chạy tay.
         Collision dùng hình khối đơn giản (đo từ mesh) thay cho mesh STL ~1e5 tam giác. -->
    <xacro:arg name="mesh_uri" default="package://objectnav_sim_gazebo/meshes"/>
    <xacro:arg name="publish_odom_tf" default="true"/>
    <xacro:arg name="lidar_samples" default="3200"/>
    <xacro:property name="mesh_uri" value="$(arg mesh_uri)"/>
    <xacro:property name="lidar_samples" value="$(arg lidar_samples)"/>

    <!-- ==================== MATERIALS & MACROS ==================== -->
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>
    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>
    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>
    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <xacro:macro name="inertial_box" params="mass x y z *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (y*y+z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * mass * (x*x+z*z)}" iyz="0.0"
                     izz="${(1/12) * mass * (x*x+y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
                     izz="${(1/2) * mass * (radius*radius)}" />
        </inertial>
    </xacro:macro>

    <!-- Trụ đặc có trục đối xứng theo y (trục quay của bánh: joint axis = 0 1 0) -> iyy = 1/2 m r^2 -->
    <xacro:macro name="inertial_cylinder_y" params="mass length radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/2) * mass * (radius*radius)}" iyz="0.0"
                     izz="${(1/12) * mass * (3*radius*radius + length*length)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_sphere" params="mass radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(2/5) * mass * (radius*radius)}" ixy="0.0" ixz="0.0"
                     iyy="${(2/5) * mass * (radius*radius)}" iyz="0.0"
                     izz="${(2/5) * mass * (radius*radius)}" />
        </inertial>
    </xacro:macro>

    <!-- ==================== PROPERTIES ==================== -->
    <xacro:property name="chassis_length" value="0.40"/>
    <xacro:property name="chassis_width" value="0.405"/>
    <xacro:property name="chassis_height" value="1.17"/>
    <xacro:property name="chassis_mass" value="25.0"/> 
    
    <xacro:property name="wheel_radius" value="0.084"/>
    <xacro:property name="wheel_width" value="0.046"/>
    <xacro:property name="wheel_mass" value="2.5"/>
    
    <xacro:property name="wheel_offset_y" value="0.232"/>

    <xacro:property name="caster_radius" value="0.10499"/> 
    <xacro:property name="caster_mass" value="0.5"/>

    <!-- ==================== LINKS & JOINTS ==================== -->
    <link name="base_link">
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
        </inertial>
    </link>

    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0" rpy="0 0 0"/> 
    </joint>

    <link name="chassis">
        <visual>
            <!-- <origin xyz="0.03 0 0.05" rpy="0 0 0"/> -->
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_uri}/Model_v1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
        <!-- Collision: 4 hộp bao theo lát cắt chiều cao của Model_v1.stl (khung base_link, m):
             thân dưới x[-0.100,0.292] y[±0.201] z[-0.011,0.530]; cột x[-0.030,0.222] y[±0.126] z[0.530,1.130];
             đầu x[-0.030,0.291] y[±0.178] z[1.130,1.373].
             Chừa khe z[0.045,0.110] quanh mặt quét LiDAR (laser_frame z=0.085, mesh RPLiDAR z[0.058,0.097])
             để cảm biến ray (khi thêm sau) không bị chính thân robot che. -->
        <collision name="chassis_base_low">
            <origin xyz="0.096 0 0.017" rpy="0 0 0"/>
            <geometry><box size="0.392 0.402 0.056"/></geometry>
        </collision>
        <collision name="chassis_base_high">
            <origin xyz="0.096 0 0.320" rpy="0 0 0"/>
            <geometry><box size="0.392 0.402 0.420"/></geometry>
        </collision>
        <collision name="chassis_column">
            <origin xyz="0.096 0 0.830" rpy="0 0 0"/>
            <geometry><box size="0.252 0.252 0.600"/></geometry>
        </collision>
        <collision name="chassis_head">
            <origin xyz="0.1305 0 1.2515" rpy="0 0 0"/>
            <geometry><box size="0.321 0.356 0.243"/></geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0.15 0 0.3" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 ${wheel_offset_y} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_uri}/hoverboard_motor_assembly.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <!-- Collision: trụ bán kính wheel_radius, trục theo y (lốp nằm ở y∈[-0.02,0.02] của mesh) -->
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder_y mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder_y>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -${wheel_offset_y} 0" rpy="0 0 3.14159"/>
        <!-- Khung khớp đã quay pi quanh z nên trục 0 -1 0 (khung khớp) = +y của base_link, cùng chiều bánh trái:
             vận tốc khớp dương ở cả hai bánh = robot tiến (giả định của gazebo_ros_diff_drive).
             Bản gốc (0 1 0) làm bánh phải quay ngược -> lệnh tiến thành quay tại chỗ. -->
        <axis xyz="0 -1 0"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_uri}/hoverboard_motor_assembly.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <!-- Collision: trụ bán kính wheel_radius, trục theo y (lốp nằm ở y∈[-0.02,0.02] của mesh) -->
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder_y mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder_y>
    </link>

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="caster_wheel"/>
        <origin xyz="0.248 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="caster_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_uri}/caster_wheel.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${-(caster_radius/2)}" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${caster_radius/2}"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="0.225 0 0.085" rpy="0 0 3.14159"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 3.14159"/>
            <geometry>
                <!-- <cylinder length="0.04" radius="0.038"/> -->
                <mesh filename="${mesh_uri}/RPLiDAR_s2.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 3.14159"/>
            <geometry>
                <cylinder length="0.04" radius="0.038"/>
                <!-- <mesh filename="${mesh_uri}/RPLiDAR_s2.stl" scale="0.001 0.001 0.001"/> -->
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.038">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="chassis"/>
        <child link="imu_link"/>
        <origin xyz="0 0 ${chassis_height/4 - 0.04}" rpy="0 0 0"/>
    </joint>

    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.02 0.01"/>
            </geometry>
            <material name="blue"/> </visual>
        
        <collision>
            <geometry>
                <box size="0.02 0.02 0.01"/>
            </geometry>
        </collision>

        <xacro:inertial_box mass="0.01" x="0.02" y="0.02" z="0.01">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <xacro:macro name="ultrasonic_link" params="name">
        <link name="${name}_link">
            <visual>
                <geometry><box size="0.015 0.02 0.04"/></geometry>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry><box size="0.015 0.02 0.04"/></geometry>
            </collision>
            <xacro:inertial_box mass="0.01" x="0.015" y="0.02" z="0.04">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>
        <gazebo reference="${name}_link"><material>Gazebo/Blue</material></gazebo>
    </xacro:macro>

    <!-- TOP -->
    <joint name="us_top_left_joint" type="fixed">
        <parent link="chassis"/>
        <child link="us_top_left_link"/>
        <origin xyz="0.29 0.18 0.445" rpy="0 0 0"/>
    </joint>
    <xacro:ultrasonic_link name="us_top_left"/>

    <joint name="us_top_right_joint" type="fixed">
        <parent link="chassis"/>
        <child link="us_top_right_link"/>
        <origin xyz="0.29 -0.18 0.445" rpy="0 0 0"/>
    </joint>
    <xacro:ultrasonic_link name="us_top_right"/>
    
    <!-- MID-TOP -->
    <joint name="us_mid_top_left_joint" type="fixed">
        <parent link="chassis"/>
        <child link="us_mid_top_left_link"/>
        <origin xyz="0.29 0.18 0.29" rpy="0 0 0"/>
    </joint>
    <xacro:ultrasonic_link name="us_mid_top_left"/>

    <joint name="us_mid_top_right_joint" type="fixed">
        <parent link="chassis"/>
        <child link="us_mid_top_right_link"/>
        <origin xyz="0.29 -0.18 0.29" rpy="0 0 0"/>
    </joint>
    <xacro:ultrasonic_link name="us_mid_top_right"/>

    <!-- MID-BOT -->
    <joint name="us_mid_bot_left_joint" type="fixed">
        <parent link="chassis"/>
        <child link="us_mid_bot_left_link"/>
        <origin xyz="0.29 0.18 0.145" rpy="0 0 0"/>
    </joint>
    <xacro:ultrasonic_link name="us_mid_bot_left"/>

    <joint name="us_mid_bot_right_joint" type="fixed">
        <parent link="chassis"/>
        <child link="us_mid_bot_right_link"/>
        <origin xyz="0.29 -0.18 0.145" rpy="0 0 0"/>
    </joint>
    <xacro:ultrasonic_link name="us_mid_bot_right"/>

    <!-- BOT
    <joint name="us_bot_left_joint" type="fixed">
        <parent link="chassis"/>
        <child link="us_bot_left_link"/>
        <origin xyz="0.29 0.145 0.04" rpy="1.5708 0 0"/>
    </joint>
    <xacro:ultrasonic_link name="us_bot_left"/>

    <joint name="us_bot_right_joint" type="fixed">
        <parent link="chassis"/>
        <child link="us_bot_right_link"/>
        <origin xyz="0.29 -0.145 0.04" rpy="1.5708 0 0"/>
    </joint>
    <xacro:ultrasonic_link name="us_bot_right"/> -->

    <!-- ==================== GAZEBO ==================== -->
    <!-- sdformat (sdf9) không chuyển <material><color> của URDF sang SDF, nên đặt màu Gazebo riêng -->
    <gazebo reference="chassis"><material>Gazebo/White</material></gazebo>
    <gazebo reference="left_wheel"><material>Gazebo/Blue</material></gazebo>
    <gazebo reference="right_wheel"><material>Gazebo/Blue</material></gazebo>
    <gazebo reference="laser_frame"><material>Gazebo/Black</material></gazebo>
    <gazebo reference="imu_link"><material>Gazebo/Blue</material></gazebo>
    <!-- Bánh caster gắn cứng (fixed joint) -> ma sát 0 để nó trượt thay vì lăn -->
    <gazebo reference="caster_wheel">
        <material>Gazebo/Black</material>
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
    </gazebo>

    <!-- LiDAR 2D: RPLIDAR S2/S2E theo thông số Slamtec — 0.05–30 m (phản xạ 90%), 10 Hz, 0.1125° (= 3200 tia/vòng,
         32000 điểm/s), sai số ±30 mm, phân giải 13 mm. stddev 0.01 m là giả định (±30 mm ≈ 3σ), không có trong datasheet.
         laser_frame quay pi như robot thật -> /scan cùng quy ước với sllidar_node (frame_id laser_frame).
         Giảm lidar_samples (vd. 720) nếu real-time factor của Gazebo tụt. -->
    <gazebo reference="laser_frame">
        <sensor name="rplidar_s2" type="ray">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>${lidar_samples}</samples>
                        <resolution>1</resolution>
                        <min_angle>${-pi}</min_angle>
                        <max_angle>${pi - 2*pi/float(lidar_samples)}</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.05</min>
                    <max>30.0</max>
                    <resolution>0.013</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="rplidar_s2_plugin" filename="libgazebo_ros_ray_sensor.so">
                <ros><remapping>~/out:=scan</remapping></ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>laser_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- IMU: BNO055 trên robot thật publish /imu/data, frame imu_link, 100 Hz. IMU mô phỏng lý tưởng (không nhiễu). -->
    <gazebo reference="imu_link">
        <sensor name="bno055" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <plugin name="bno055_plugin" filename="libgazebo_ros_imu_sensor.so">
                <ros><remapping>~/out:=imu/data</remapping></ros>
                <frame_name>imu_link</frame_name>
                <initial_orientation_as_reference>false</initial_orientation_as_reference>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo>
        <!-- Dẫn động vi sai: /cmd_vel -> bánh, /odom từ encoder (odometry_source 0, có trượt như thật, không phải
             ground truth). wheel_separation/diameter khớp wheel_odom_params.yaml (0.464 m, r = 0.084 m).
             max_wheel_acceleration (m/s² tại vành bánh) = acc_lim_x của Nav2 (1.5); max_wheel_torque 20 N·m là giả định.
             publish_odom_tf:=false khi chạy EKF (robot_localization) để tránh 2 nguồn TF odom->base_footprint. -->
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
            <update_rate>100</update_rate>
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>${2*wheel_offset_y}</wheel_separation>
            <wheel_diameter>${2*wheel_radius}</wheel_diameter>
            <max_wheel_torque>20</max_wheel_torque>
            <max_wheel_acceleration>1.5</max_wheel_acceleration>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>$(arg publish_odom_tf)</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odometry_source>0</odometry_source>
        </plugin>

        <!-- /joint_states của 2 bánh -> robot_state_publisher phát TF base_link->left/right_wheel -->
        <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
            <update_rate>50</update_rate>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

</robot>